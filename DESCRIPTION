Package: textclasstutorial
Title: Reproducible Text Classification Workflows
Version: 0.1.0
Authors@R: c(
    person("Vladimer", "Kobayashi", role = c("aut", "cre"),
           email = "vladimer.kobayashi@gmail.com"),
    person("Stefan", "Mol", role = "aut"),
